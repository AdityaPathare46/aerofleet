{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aerofleet-tauri",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "tauri-app"],
      "port": 1420
    },
    {
      "name": "aerofleet-api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "aerofleet.api.app:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    }
  ]
}
