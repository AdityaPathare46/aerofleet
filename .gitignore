# Vector Database
src/vector_index.pkl
*.faiss

# Legacy orbital-mechanics datasets (24GB+ of SPICE kernels, gravity models,
# NASA report corpora) inherited from the pre-pivot project — unreferenced
# by the live aerofleet drone-dispatch app (Phase AJ confirmed only the now-
# removed aerofleet/data/loader.py touched these). Too large for git and not
# needed to run or test AeroFleet.
datasets/
data/docs/

# Regeneratable runtime caches — osmnx geocoding/street-graph cache and the
# embeddings vector DB. Rebuilt automatically on first run; committing them
# just bloats the repo with binary blobs that go stale immediately.
cache/
data/city_cache/
data/vector_db/

# Generated scenario-run reports (dated JSON/txt output) — reproducible by
# re-running scenario_engine, not source.
scenario_reports/

# Mac OS metadata files
._*

# Node modules and Rust builds
node_modules/
target/
