# AeroFleet - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ========================================
# Application Settings
# ========================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ========================================
# LLM Configuration
# ========================================
# Ollama (Local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=300

# OpenAI (Optional - for cloud LLM)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic (Optional)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-opus-20240229

# ========================================
# Data Paths
# ========================================
PROJECT_ROOT=/Volumes/One Touch/SpaceMissionArchitect
CITY_GRAPH_CACHE_PATH=${PROJECT_ROOT}/data/city_cache
COMPONENTS_DB_PATH=${PROJECT_ROOT}/data/components.json
SAVED_MISSIONS_PATH=${PROJECT_ROOT}/saved_missions

# ========================================
# City / Airspace Configuration
# ========================================
# DEMO_CITY is only a fallback for direct CityGraph use; the API and desktop
# app select cities from aerofleet/city/registry.py (currently Pune, Mumbai)
# via the ?city= query param — add more cities there, not here.
DEMO_CITY=Pune, Maharashtra, India
AIRSPACE_ZONES_CONFIG=${PROJECT_ROOT}/config/airspace_zones.yaml
REGULATORY_FRAMEWORK=DGCA_2021  # India Drone Rules 2021 (Digital Sky, Green/Yellow/Red zones)

# ========================================
# Database Configuration
# ========================================
# SQLite (Development)
DATABASE_URL=sqlite:///./aerofleet.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/aerofleet
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# ========================================
# Redis Cache (Optional)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Cache TTL (seconds)
CACHE_TTL_TRAJECTORY=3600
CACHE_TTL_LLM_RESPONSE=7200

# ========================================
# API Configuration
# ========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ========================================
# Dashboard Configuration
# ========================================
DASHBOARD_PORT=8501
DASHBOARD_TITLE="AeroFleet"
DASHBOARD_THEME=dark  # light, dark

# ========================================
# Agent Configuration
# ========================================
MAX_AGENTS=12
AGENT_TIMEOUT=60
ENABLE_COUNCIL_DEBATE=true
# Set to true to use the deterministic MockLLMBackend instead of live Ollama
# (useful for offline dev/CI when the GPU server is unreachable).
USE_MOCK_AGENTS=false

# ========================================
# Per-Agent Model Assignments (Production)
# ========================================
# Each agent uses a specialized model. Override any agent's model below.
# If not set, defaults from AgentFactory.DEFAULT_MODEL_MAP are used.
# If those models aren't installed, falls back to OLLAMA_MODEL above.
# All models below are open-weight and non-Chinese-origin (Meta/Mistral AI/Google/Microsoft).
#
# AGENT_MODEL_DISPATCHER=llama4:scout
# AGENT_MODEL_ROUTE=mistral-small3.2
# AGENT_MODEL_BATTERY=phi4-reasoning:plus
# AGENT_MODEL_AIRSPACE_SAFETY=llama4:scout
# AGENT_MODEL_WEATHER=gemma4:12b
# AGENT_MODEL_COMMS=mistral-small3.2
# AGENT_MODEL_COST=phi4-reasoning:plus
# AGENT_MODEL_OPS=gemma4:12b
# AGENT_MODEL_COMPLIANCE=mistral-large-3
# AGENT_MODEL_AI_VALIDATOR=llama4:scout
# AGENT_MODEL_PAYLOAD=phi4-reasoning:plus
# AGENT_MODEL_CONTINGENCY=llama4:scout

# ========================================
# Simulation Settings
# ========================================
SIMULATION_MAX_DURATION_HOURS=24
SIMULATION_TIME_STEP_SECONDS=10
ENABLE_ANOMALY_INJECTION=true
ANOMALY_PROBABILITY=0.15

# ========================================
# Fleet & Battery Defaults
# ========================================
DEFAULT_BATTERY_CAPACITY_WH=500
DEFAULT_BATTERY_RESERVE_MARGIN=0.20  # fraction reserved for return-to-home
DEFAULT_DRONE_PAYLOAD_KG=5
DEFAULT_DEPOT_COUNT=6

# ========================================
# Monitoring & Observability
# ========================================
ENABLE_METRICS=true
PROMETHEUS_PORT=9090

# Sentry (Error Tracking)
# SENTRY_DSN=

# ========================================
# Security
# ========================================
# Secret key for session management (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# JWT Settings (if implementing auth)
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=30

# ========================================
# Feature Flags
# ========================================
ENABLE_KNOWLEDGE_BASE=true
ENABLE_RL_OPTIMIZER=false
ENABLE_REPORT_GENERATION=true
ENABLE_3D_VISUALIZATION=true

# ========================================
# Performance
# ========================================
MAX_WORKERS=4
ASYNC_MODE=true
